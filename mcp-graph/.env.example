# Host address docker-compose publishes this service's port on. Unset, it binds to
# 127.0.0.1 (loopback-only — not reachable from the tailnet or LAN). Set this to your
# Tailscale IP (`tailscale ip -4`) to make it reachable over the tailnet, the way
# README.md describes. Do not set it to 0.0.0.0 unless you have your own firewall
# rules blocking non-tailnet traffic to this port.
BIND_ADDR=127.0.0.1

GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
MCP_AUTH_TOKEN=
