# Host address docker-compose publishes this service's port on. Unset, it binds to
# 127.0.0.1 (loopback-only — not reachable from the tailnet or LAN). Set this to your
# Tailscale IP (`tailscale ip -4`) to make it reachable over the tailnet, the way
# README.md describes. Do not set it to 0.0.0.0 unless you have your own firewall
# rules blocking non-tailnet traffic to this port.
BIND_ADDR=127.0.0.1

GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
MCP_AUTH_TOKEN=

# Comma-separated UPNs (or object IDs) of break-glass/emergency-access accounts, e.g.
# breakglass1@contoso.onmicrosoft.com,breakglass2@contoso.onmicrosoft.com
# disable_user and delete_user refuse to act on any account in this list. This is the
# authoritative protection — set it before using either tool. A name-based heuristic
# (UPN contains "break" or "emergency") is also applied as an extra net, but it is not
# a substitute: it can both wrongly block a legitimately named account and wrongly miss
# a break-glass account that isn't named with those words.
PROTECTED_UPNS=
