# Host address docker-compose publishes this service's port on. Unset, it binds to
# 127.0.0.1 (loopback-only — not reachable from the tailnet or LAN). Set this to your
# Tailscale IP (`tailscale ip -4`) to make it reachable over the tailnet, the way
# README.md describes. Do not set it to 0.0.0.0 unless you have your own firewall
# rules blocking non-tailnet traffic to this port.
BIND_ADDR=127.0.0.1

# Absolute host directory holding the shared action.log that mcp-graph, mcp-tailscale
# and dashboard all read/write — mounted narrowly at /data in each container instead of
# the old full-home-directory mount. Required: there's no safe non-personal default
# for a path on your filesystem, so docker compose refuses to start until this is set.
# Create the directory once (`mkdir -p`) and set this to the SAME absolute path in both
# mcp-graph/.env and mcp-tailscale/.env — it's one shared directory across both compose
# projects, not a per-project one.
SHARED_DATA_DIR=

# Set to "true" to expose disable_user and delete_user as MCP tools at all — unset or
# anything else, they're absent from the tool list entirely, not just refusing calls.
# Granting the Graph permissions in SETUP-WITH-AI.md's table isn't sufficient on its
# own; this flag is the explicit opt-in on top of that. pre_delete_check stays
# available either way — it's read-only.
ENABLE_ACCOUNT_MUTATIONS=false

GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
MCP_AUTH_TOKEN=
