# Host address docker-compose publishes these services' ports on. Unset, everything
# binds to 127.0.0.1 (loopback-only — not reachable from the tailnet or LAN). Set this
# to your Tailscale IP (`tailscale ip -4`) to make it reachable over the tailnet, the
# way README.md describes. Do not set it to 0.0.0.0 unless you have your own firewall
# rules blocking non-tailnet traffic to these ports.
BIND_ADDR=127.0.0.1

# Absolute host directory holding the shared action.log that mcp-tailscale, dashboard
# and mcp-graph all read/write — mounted narrowly at /data in each container instead of
# the old full-home-directory mount. Required: there's no safe non-personal default
# for a path on your filesystem, so docker compose refuses to start until this is set.
# Create the directory once (`mkdir -p`) and set this to the SAME absolute path in both
# mcp-tailscale/.env and mcp-graph/.env — it's one shared directory across both compose
# projects, not a per-project one.
SHARED_DATA_DIR=

# Set to "true" to expose run_command, restart_service, get_logs and disk_usage as MCP
# tools at all — unset or anything else, they're absent from the tool list entirely,
# not just refusing calls. Also requires bringing the stack up with
# docker-compose.admin.yml (see that file) to actually get Docker-socket access; this
# flag alone isn't sufficient, and the socket mount alone isn't either — both opt-ins
# are required together.
ENABLE_ADMIN_TOOLS=false

TAILSCALE_API_KEY=
TAILSCALE_TAILNET=
MCP_AUTH_TOKEN=

GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=

NTFY_URL=http://ntfy:80
NTFY_TOPIC=homelab-alerts
POLL_INTERVAL=60
