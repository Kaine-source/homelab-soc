# Host address docker-compose publishes these services' ports on. Unset, everything
# binds to 127.0.0.1 (loopback-only — not reachable from the tailnet or LAN). Set this
# to your Tailscale IP (`tailscale ip -4`) to make it reachable over the tailnet, the
# way README.md describes. Do not set it to 0.0.0.0 unless you have your own firewall
# rules blocking non-tailnet traffic to these ports.
BIND_ADDR=127.0.0.1

TAILSCALE_API_KEY=
TAILSCALE_TAILNET=
MCP_AUTH_TOKEN=

GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=

NTFY_URL=http://ntfy:80
NTFY_TOPIC=homelab-alerts
POLL_INTERVAL=60
